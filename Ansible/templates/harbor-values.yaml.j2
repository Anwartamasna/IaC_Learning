expose:
  type: nodePort
  tls:
    enabled: false
  nodePort:
    name: harbor
    ports:
      http:
        port: 80
        nodePort: 30002
      https:
        port: 443
        nodePort: 30003
externalURL: http://{{ inventory_hostname }}:30002
harborAdminPassword: Harbor12345
trivy:
  enabled: false
notary:
  enabled: false
persistence:
  enabled: true
  persistentVolumeClaim:
    registry:
      size: 2Gi
    database:
      size: 1Gi
    redis:
      size: 1Gi
